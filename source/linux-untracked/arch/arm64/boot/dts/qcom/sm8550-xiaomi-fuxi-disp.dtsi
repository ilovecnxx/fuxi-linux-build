// SPDX-License-Identifier: BSD-3-Clause
/*
 * Xiaomi 13 (fuxi)：原生显示驱动变体。在 sm8550-xiaomi-fuxi-min.dts 的基础上，把 simpledrm +
 * MDSS 占位换成真正的 MSM 显示通路（dispcc + MDSS/DPU + DSI0 + 7nm DSI PHY + 面板驱动
 * panel-xiaomi-fuxi）。面板参数取自厂商 DTB qcom,mdss_dsi_m3_38_0c_0a_dsc_cmd（见
 * work/device-info/panel-m3-38-0c-0a.dtsi）。
 *
 * 构建：FUXI_DTB=sm8550-xiaomi-fuxi-disp scripts/fuxi-build-abl.sh <名字>
 */


/ {
	/* 面板三路电源都是 GPIO 控制的负载开关（厂商 display_panel_vddio/vci/vddd），开机时已打开 */
	panel_vddio_1p8: regulator-panel-vddio {
		compatible = "regulator-fixed";
		regulator-name = "panel_vddio_1p8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&tlmm 126 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};

	panel_vci_3p0: regulator-panel-vci {
		compatible = "regulator-fixed";
		regulator-name = "panel_vci_3p0";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;
		gpio = <&tlmm 127 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};

	panel_vddd_1p5: regulator-panel-vddd {
		compatible = "regulator-fixed";
		regulator-name = "panel_vddd_1p5";
		regulator-min-microvolt = <1500000>;
		regulator-max-microvolt = <1500000>;
		gpio = <&tlmm 42 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};
};

&dispcc {
	status = "okay";
};

/*
 * 原生显示变体只让 MSM DPU/DSI 作为 DRM 输出。保留启动 framebuffer 的保留内存与
 * fuxi 早期 console，但不注册第二张 simpledrm 卡，避免桌面选中旧 bootloader 输出。
 */
&framebuffer0 {
	status = "disabled";
};

/* -min 里为了当 sync_state 占位删掉了 iommus；真驱动要用 SMMU */
&mdss {
	iommus = <&apps_smmu 0x1c00 0x2>;
	status = "okay";
};

&mdss_dsi0 {
	vdda-supply = <&vreg_l3e_1p2>;
	status = "okay";

	panel@0 {
		compatible = "xiaomi,fuxi-m3-38-0c-0a";
		reg = <0>;

		pinctrl-0 = <&sde_dsi_active>, <&sde_te>;
		pinctrl-1 = <&sde_dsi_suspend>, <&sde_te>;
		pinctrl-names = "default", "sleep";

		reset-gpios = <&tlmm 133 GPIO_ACTIVE_LOW>;

		vddio-supply = <&panel_vddio_1p8>;
		vddd-supply = <&panel_vddd_1p5>;
		vci-supply = <&panel_vci_3p0>;

		port {
			panel0_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};
};

&mdss_dsi0_out {
	remote-endpoint = <&panel0_in>;
	data-lanes = <0 1 2 3>;
};

&mdss_dsi0_phy {
	vdds-supply = <&vreg_l1e_0p88>;
	status = "okay";
};

&tlmm {
	sde_dsi_active: sde-dsi-active-state {
		pins = "gpio133";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	sde_dsi_suspend: sde-dsi-suspend-state {
		pins = "gpio133";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	/* 厂商 sde_te_active：GPIO86 mdp_vsync */
	sde_te: sde-te-state {
		pins = "gpio86";
		function = "mdp_vsync";
		drive-strength = <2>;
		bias-pull-down;
	};
};

/*
 * GPU：Adreno 740。a740_sqe.fw、gmu_gen70200.bin 放 /lib/firmware/qcom/；签名的 zap shader 取自 Android
 * /vendor/firmware（a740_zap.mdt + .bNN），放 /lib/firmware/qcom/sm8550/xiaomi/fuxi/。
 * 固件在第一次打开 GPU 时才加载（那时根文件系统已挂好）。
 */
&gpu {
	status = "okay";
};

&gpu_zap_shader {
	firmware-name = "qcom/sm8550/xiaomi/fuxi/a740_zap.mdt";
};
