diff --git a/arch/arm64/Kconfig b/arch/arm64/Kconfig
index 292392ded..0f5cacb89 100644
--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -460,6 +460,14 @@ config AMPERE_ERRATUM_AC04_CPU_23
 config ARM64_WORKAROUND_CLEAN_CACHE
 	bool
 
+config FUXI_FORCE_BUILTIN_DTB
+	bool "fuxi: force use of built-in board DTB"
+	default n
+	help
+	  Xiaomi 13 (fuxi) 的 ABL 只能处理厂商 DTB（它会叠加 dtbo 分区的 overlay）。
+	  打开后内核在 setup_arch 里忽略 ABL 传入的 DTB，改用编进内核的
+	  sm8550-xiaomi-fuxi-min.dtb（arch/arm64/kernel/fuxi_dtb.S）。
+
 config ARM64_ERRATUM_826319
 	bool "Cortex-A53: 826319: System might deadlock if a write cannot complete until read data is accepted"
 	default y
