--- a/arch/arm64/kernel/Makefile
+++ b/arch/arm64/kernel/Makefile
@@ -90,3 +90,8 @@ endif
 
 # for cleaning
 subdir- += vdso vdso32
+
+# fuxi（Xiaomi 13）：内建主线板级 DTB + simpledrm 之前的早期屏幕 console
+obj-$(CONFIG_FUXI_FORCE_BUILTIN_DTB)	+= fuxi_dtb.o fuxi_early.o
+# DTB 改了要重新嵌入
+$(obj)/fuxi_dtb.o: arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi-min.dtb
diff --git a/arch/arm64/kernel/setup.c b/arch/arm64/kernel/setup.c
index a707deba6..2cd71fe09 100644
--- a/arch/arm64/kernel/setup.c
+++ b/arch/arm64/kernel/setup.c
@@ -289,6 +289,16 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 	early_fixmap_init();
 	early_ioremap_init();
 
+	/*
+	 * fuxi: ABL 会把 dtbo 分区的厂商 overlay 叠到 boot 镜像附带的 DTB 上，叠到主线
+	 * DTB 会卡死，所以 boot 镜像附带厂商 DTB，内核在这里改用编进来的主线 DTB。
+	 */
+#if IS_ENABLED(CONFIG_FUXI_FORCE_BUILTIN_DTB)
+	{
+		extern const unsigned char fuxi_dtb[];
+		__fdt_pointer = __pa_symbol((unsigned long)fuxi_dtb);
+	}
+#endif
 	setup_machine_fdt(__fdt_pointer);
 
 	/*
